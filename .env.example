# Database - SQLite for local development (file-based, no server needed)
# For production, use PostgreSQL: postgresql://user:password@host:5432/contagt?schema=public
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="contagt-super-secret-key-change-in-production-min-32-chars"

# Google OAuth (optional - for login with Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
APP_NAME="ContaGT"
APP_URL="http://localhost:3000"